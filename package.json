{
  "name": "accessible-ui",
  "version": "0.1.0",
  "description": "Small React component library built accessibility-first, with keyboard tests in a real browser and base-vs-head visual regression",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "storybook dev --no-open -p 5193",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:keyboard": "vitest run --project=keyboard",
    "test:stories": "vitest run --project=stories-light --project=stories-dark",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:storybook": "node visual/build-storybook.ts",
    "visual": "node visual/run.ts",
    "check:package": "publint --strict"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.12",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.8",
    "typescript": "5.9",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "vitest-browser-react": "^2.3.0"
  }
}
